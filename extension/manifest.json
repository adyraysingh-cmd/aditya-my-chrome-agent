{
  "manifest_version": 3,
  "name": "OpenAI Chrome Autopilot",
  "version": "0.2.1",
  "description": "Claude-style persistent chat with an autonomous browser agent powered by OpenAI.",
  "permissions": ["activeTab", "tabs", "storage", "scripting", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "OpenAI Autopilot" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }]
}
